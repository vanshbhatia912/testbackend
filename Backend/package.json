{
  "name": "remote-desktop-low-latency",
  "version": "2.0.0",
  "description": "High-performance remote desktop application with low latency optimizations",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "server:dev": "nodemon server.js",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest",
    "lint": "eslint .",
    "benchmark": "node scripts/benchmark.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
